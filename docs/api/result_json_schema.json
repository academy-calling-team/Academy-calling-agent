{
  "$defs": {
    "AnswerInput": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "question_code": {
          "enum": [
            "shuttle",
            "pickup",
            "level_fit",
            "vacancy",
            "level_test",
            "class_time"
          ],
          "title": "Question Code",
          "type": "string"
        },
        "asked": {
          "title": "Asked",
          "type": "boolean"
        },
        "answered": {
          "title": "Answered",
          "type": "boolean"
        },
        "yes_no": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yes No"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "refused",
                "not_asked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "detail": {
          "maxLength": 2000,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "question_code",
        "asked",
        "answered",
        "yes_no",
        "detail"
      ],
      "title": "AnswerInput",
      "type": "object"
    },
    "Latency": {
      "additionalProperties": false,
      "properties": {
        "mean_ms": {
          "minimum": 0,
          "title": "Mean Ms",
          "type": "integer"
        },
        "p95_ms": {
          "minimum": 0,
          "title": "P95 Ms",
          "type": "integer"
        },
        "turns": {
          "minimum": 1,
          "title": "Turns",
          "type": "integer"
        }
      },
      "required": [
        "mean_ms",
        "p95_ms",
        "turns"
      ],
      "title": "Latency",
      "type": "object"
    },
    "TranscriptTurn": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "enum": [
            "agent",
            "academy"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "at_ms": {
          "minimum": 0,
          "title": "At Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "at_ms",
        "text"
      ],
      "title": "TranscriptTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Result Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "answered",
        "no_answer",
        "busy",
        "rejected",
        "machine",
        "invalid_number"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "disclosure_played": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Disclosure Played"
    },
    "consult_accepted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Consult Accepted"
    },
    "available_times": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Available Times",
      "type": "array"
    },
    "answers": {
      "items": {
        "$ref": "#/$defs/AnswerInput"
      },
      "maxItems": 6,
      "title": "Answers",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Unresolved",
      "type": "array"
    },
    "summary_text": {
      "maxLength": 2000,
      "title": "Summary Text",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 1000,
      "title": "Notes",
      "type": "string"
    },
    "latency": {
      "anyOf": [
        {
          "$ref": "#/$defs/Latency"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_sec": {
      "maximum": 86400,
      "minimum": 0,
      "title": "Duration Sec",
      "type": "integer"
    },
    "transcript": {
      "items": {
        "$ref": "#/$defs/TranscriptTurn"
      },
      "maxItems": 1000,
      "title": "Transcript",
      "type": "array"
    },
    "recording_url": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recording Url"
    },
    "callback_requested": {
      "default": false,
      "title": "Callback Requested",
      "type": "boolean"
    },
    "callback_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Callback At"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "enum": [
            "temporary",
            "permanent",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    }
  },
  "required": [
    "result_id",
    "outcome",
    "disclosure_played",
    "consult_accepted",
    "available_times",
    "answers",
    "unresolved",
    "summary_text",
    "latency",
    "duration_sec",
    "transcript"
  ],
  "title": "ResultInput",
  "type": "object"
}