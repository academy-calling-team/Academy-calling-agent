  "components": {
    "schemas": {
      "AnswerInput": {
        "properties": {
          "question_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Question Id"
          },
          "question_code": {
            "type": "string",
            "enum": [
              "shuttle",
              "pickup",
              "level_fit",
              "vacancy",
              "level_test",
              "class_time"
            ],
            "title": "Question Code"
          },
          "asked": {
            "type": "boolean",
            "title": "Asked"
          },
          "answered": {
            "type": "boolean",
            "title": "Answered"
          },
          "yes_no": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Yes No"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "refused",
                  "not_asked"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "detail": {
            "type": "string",
            "maxLength": 2000,
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "question_code",
          "asked",
          "answered",
          "yes_no",
          "detail"
        ],
        "title": "AnswerInput"
      },
      "CallbackReview": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "schedule",
              "cancel"
            ],
            "title": "Action"
          },
          "callback_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback At"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "CallbackReview"
      },
      "CorrectionInput": {
        "properties": {
          "base_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Revision"
          },
          "reviewer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reviewer"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "payload": {
            "$ref": "#/components/schemas/ResultInput"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_revision",
          "reviewer",
          "reason",
          "payload"
        ],
        "title": "CorrectionInput"
      },
      "Credentials": {
        "properties": {
          "login_name": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]+$",
            "title": "Login Name"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "login_name",
          "password"
        ],
        "title": "Credentials"
      },
      "EventInput": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Event Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "initiated",
              "ringing",
              "answered",
              "no_answer",
              "busy",
              "rejected",
              "machine",
              "invalid_number",
              "completed",
              "barge_in"
            ],
            "title": "Type"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "type",
          "occurred_at"
        ],
        "title": "EventInput"
      },
      "FallbackReview": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "dismiss"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "FallbackReview"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InquiryInput": {
        "properties": {
          "inquirer_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Inquirer Id"
          },
          "academy_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Academy Id"
          },
          "student": {
            "$ref": "#/components/schemas/Student"
          },
          "question_codes": {
            "items": {
              "type": "string",
              "enum": [
                "shuttle",
                "pickup",
                "level_fit",
                "vacancy",
                "level_test",
                "class_time"
              ]
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Question Codes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "inquirer_id",
          "academy_id",
          "student",
          "question_codes"
        ],
        "title": "InquiryInput"
      },
      "Latency": {
        "properties": {
          "mean_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Mean Ms"
          },
          "p95_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "P95 Ms"
          },
          "turns": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Turns"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mean_ms",
          "p95_ms",
          "turns"
        ],
        "title": "Latency"
      },
      "RegistrationCredentials": {
        "properties": {
          "login_name": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]+$",
            "title": "Login Name"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "terms_agreed": {
            "type": "boolean",
            "title": "Terms Agreed"
          }
        },
