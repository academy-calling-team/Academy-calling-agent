# 백엔드를 Python으로 직접 실행할 때 저장소 루트 .env에 설정한다.
# Docker Compose는 infra/setup-local.py로 전용 설정을 생성한다.
# 음성 워커 설정은 voice/.env.example을 참고한다. 실제 값은 커밋하지 않는다.
APP_MODE=development_mock
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REDIS_URL=redis://127.0.0.1:6379/1
INTERNAL_API_KEY=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3306
TEST_MYSQL_USER=
TEST_MYSQL_PASSWORD=
TEST_MYSQL_DATABASE=
TEST_REDIS_URL=redis://127.0.0.1:6379/14
