# voice/.env에 복사하고 담당자가 필요한 값을 설정한다. 실제 발신은 기본 OFF.
INTERNAL_KEY=
BACKEND_URL=http://127.0.0.1:18770
WORKER_HOST=127.0.0.1
WORKER_PORT=18780
MOCK_SCENARIO=answered
MOCK_DELAY_SEC=2
REAL_CALLS_ENABLED=0
REAL_CALL_ALLOWED_TO=
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_SERVICE_AGENT_ID=
CLAWOPS_FROM_NUMBER=
# 비우면 키워드 판정. 모델을 지정하면 해당 제공업체의 키가 필요하다.
LLM_JUDGE_MODEL=
LLM_JUDGE_TIMEOUT_SEC=30
OPENAI_API_KEY=
GEMINI_API_KEY=
