# 실제 값은 저장소 루트 .env에만 설정. 키/암호 항목은 빈 값으로 유지.
APP_MODE=development_mock
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
REDIS_URL=redis://127.0.0.1:6379/0
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 통합 테스트는 별도 로컬 DB와 별도 Redis DB 번호 사용.
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3306
TEST_MYSQL_USER=
TEST_MYSQL_PASSWORD=
TEST_MYSQL_DATABASE=
TEST_REDIS_URL=redis://127.0.0.1:6379/1

# 향후 음성팀 연동용. 현재 코드에서 실제 발신에 사용하지 않음.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
CLAWOPS_API_KEY=
